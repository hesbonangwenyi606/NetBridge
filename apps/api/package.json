{
  "name": "@netbridge/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run prisma:generate && npm run clean && tsc -p tsconfig.json",
    "start:dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/run-tests.cjs",
    "verify:deployment": "npm run build && node scripts/verify-deployment.cjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/swagger": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.3.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@nestjs/testing": "^12.3.3",
    "@types/node": "^22.13.4",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.3",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
