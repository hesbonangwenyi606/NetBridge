{
  "name": "netbridge",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace @netbridge/api",
    "start:dev": "npm run start:dev --workspace @netbridge/api",
    "start": "npm run start --workspace @netbridge/api",
    "web:dev": "npm run dev --workspace @netbridge/web",
    "web:build": "npm run build --workspace @netbridge/web",
    "web:start": "npm run start --workspace @netbridge/web",
    "web:test": "npm run test --workspace @netbridge/web",
    "test:e2e": "npm run build && npm run web:build && playwright test",
    "test": "npm run test --workspace @netbridge/api",
    "verify:deployment": "npm run verify:deployment --workspace @netbridge/api",
    "db:generate": "npm run prisma:generate --workspace @netbridge/api",
    "db:validate": "npm run prisma:validate --workspace @netbridge/api",
    "db:migrate": "npm run db:migrate --workspace @netbridge/api",
    "db:deploy": "npm run db:deploy --workspace @netbridge/api",
    "db:studio": "npm run db:studio --workspace @netbridge/api",
    "app:dev": "npm run build && node apps/api/scripts/run-local.cjs",
    "gateway:pair": "node apps/gateway-agent/agent.mjs pair",
    "gateway:start": "node apps/gateway-agent/agent.mjs start",
    "gateway:status": "node apps/gateway-agent/agent.mjs status",
    "gateway:test": "node --test apps/gateway-agent/agent.test.mjs"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^12.3.3",
    "@playwright/test": "^1.65.0"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  }
}
